# Скопируйте в .env.docker и заполните. Файл .env.docker не коммитится.

# Telegram
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Публичный HTTPS-адрес сайта: ссылки на форму отзыва и Mini App.
WEB_APP_URL=
TG_WEBAPP_AUTH=strict

# VK Mini App
VK_APP_ID=54558405
VK_APP_SECRET=
VK_ID_OFFSET=10000000000

# Прочее
MAX_HOMEWORK_UPLOAD_MB=450
CHAT_ENABLED=true
APP_NOTIFICATIONS_RETENTION_DAYS=90
