# Переменные окружения docker compose: файл .env (cp .env.example .env) или переменные платформы деплоя.
# Файл .env не коммитится. Без .env стек тоже поднимается: сайт и API работают, бот ждёт BOT_TOKEN.

# Порт сайта на хосте (http://localhost:8080)
WEB_PORT=8080

# Telegram
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Прокси Bot API, если сервер не достаёт до api.telegram.org; по умолчанию https://api.telegram.org
TELEGRAM_API_BASE_URL=
# Публичный HTTPS-адрес сайта: ссылки на форму отзыва и Mini App.
WEB_APP_URL=
TG_WEBAPP_AUTH=strict

# VK Mini App
VK_APP_ID=54558405
VK_APP_SECRET=
VK_ID_OFFSET=10000000000

# Прочее
MAX_HOMEWORK_UPLOAD_MB=450
CHAT_ENABLED=true
APP_NOTIFICATIONS_RETENTION_DAYS=90
