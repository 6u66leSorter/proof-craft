{
  "name": "proof-craft-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "visual:test": "playwright test -c visual/playwright.config.ts",
    "visual:test:next": "VISUAL_TARGET=next playwright test -c visual/playwright.config.ts",
    "visual:update": "playwright test -c visual/playwright.config.ts --update-snapshots=all",
    "visual:legacy-api": "node visual/legacy-api/start.mjs",
    "visual:approve-deviations": "VISUAL_TARGET=next playwright test -c visual/playwright.config.ts --update-snapshots=missing"
  },
  "devDependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@vkontakte/vk-bridge": "^3.0.2",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
